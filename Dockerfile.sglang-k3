# Runtime image: Kimi-K3-capable SGLang + open-llms entrypoint
# (specs/018 AC4). Separate from Dockerfile.sglang on purpose: K3 support
# lives in a CUDA 13 branch build that needs an r580+ NVIDIA driver, and
# folding it into the shared image would impose that driver on the
# h200/b200 pools for a model that cannot run there anyway.
# amd64 (B300 HGX); the -arm64 tag is the Grace variant.
FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/runtime ./cmd/runtime

FROM lmsysorg/sglang:kimi-k3-c6ad1f26-20260729-amd64
COPY --from=build /out/runtime /usr/local/bin/runtime
# s5cmd for nvme-cache weight sync from S3.
RUN pip install --no-cache-dir huggingface_hub[hf_transfer] \
    && curl -fsSL https://github.com/peak/s5cmd/releases/download/v2.3.0/s5cmd_2.3.0_Linux-64bit.tar.gz \
       | tar -xz -C /usr/local/bin s5cmd
EXPOSE 8000
ENTRYPOINT ["runtime", "serve"]
CMD ["--manifest", "/etc/openllms/model.yaml"]
